# Minimal runnable backend configuration.
# Docker Compose injects container Redis/RabbitMQ URLs.
# Local shell runs use code defaults unless the optional overrides below are enabled.

ADMIN_ID=change-me-before-use
ADMIN_PW=change-me-before-use
ADMIN_UI_SECRET_KEY=change-me-admin-ui-secret

DEFAULT_AUTO_EXECUTION_BACKEND=openrouter
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=openrouter/openai/gpt-5.2
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
RAG_CHAT_MODEL=openrouter/openai/gpt-5.2

# Optional: use Qwen through OpenRouter by switching the model.
# OPENAI_MODEL=openrouter/qwen3-vl-32b
# OPENROUTER_VISUAL_VERIFY=0

# RAG answer provider. Embeddings use OPENAI_API_KEY by default.
RAG_PROVIDER=openrouter
RAG_OPENROUTER_MODEL=openai/gpt-5.2
RAG_EMBEDDING_PROVIDER=openrouter
RAG_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
RAG_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional OpenRouter attribution headers.
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=Luminir RAG

# Optional local shell infra overrides.
# Not required for docker compose; compose sets redis://redis and amqp://rabbitmq.
# QUEUE_BACKEND=rabbitmq
# QUEUE_MEMORY_FALLBACK_ENABLED=0
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
# RABBITMQ_QUEUE=jobs.queue
# STORE_BACKEND=sqlite
# STATUS_CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# Optional local ports.
# API_PORT=8000
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

# Optional on-prem Qwen overrides.
# BACKEND_IMAGE=luminir-backend:onprem
# ENABLE_LOCAL_QWEN_MODEL=1
# QWEN_MODEL_HOST_DIR=../models
# QWEN_VL_7B_MODEL_PATH=/models/Qwen2.5-VL-7B-Instruct
# CUDA_VISIBLE_DEVICES=0
# QWEN_INFER_WORKER_MAX_CONCURRENCY=1
# QWEN_INFER_GPU_SLOTS=1

# Optional on-prem lightweight defaults.
# Lower values reduce VRAM/token cost at the expense of detail on dense tables.
# QWEN_VISION_MIN_PIXELS=100352
# QWEN_VISION_MAX_PIXELS=702464
# QWEN_TABLE_MAX_TOKENS=512
# QWEN_FLOWCHART_MAX_TOKENS=384
# QWEN_MATH_MAX_TOKENS=384
# QWEN_IMAGE_MAX_TOKENS=384
# QWEN_RETRY_MAX_TOKENS=768
# QWEN_GENERATE_MAX_TIME=90
# OMP_NUM_THREADS=2
# MKL_NUM_THREADS=2
# OPENBLAS_NUM_THREADS=2
# TOKENIZERS_PARALLELISM=false
